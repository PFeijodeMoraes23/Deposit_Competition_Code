# stagec_requests.env — EVERY SLURM request of the stage C estimation run, in one place.
# Sourced by stagec_suite_20261012.sh. A resize is a one-line change here; the tests assert that
# the submissions carry these values. Sized 10-14 from the measured run (sacct, 10-13/14):
# memory ~2x MaxRSS (room for the new panel), wall a few times the runtime with sensible floors.
# The cpugen pin: T4 builds the CPU sysimage, which runs only on the CPU it was built on; T3 runs
# where every 10-13 chain job ran (cpugen:turin: the same CPU family for the prep and logit
# arithmetic, and the same CPU target as T4, so the two never precompile the shared depot for
# different CPUs; user, 10-15, review M1/M2). The launch, the GPU job and the small hand-off jobs
# load no CPU image and compute nothing CPU-specific: unpinned (the BBL's CPU steps get their pin
# from bbl_run.sh). A *_PIN left empty means no constraint.
#
#   measured: env_julia 6.1 GB/13 min, sleep_prep 26.0 GB/0:31, blp_logit 3.6 GB/3:01,
#   blp_draws 47.8 GB/2:13, GPU sysimage 13.8 GB/5:26, smoke 174.5 GB/30:08 (per routine process),
#   CPU sysimage 6 min (10-13, after env_julia had precompiled the depot).

# T1 — the launch job (the one line the user pastes; the header's launch line must match):
# guards, install, the Julia environment (instantiate only), then T3 and T2 are submitted.
REQ_LAUNCH_PART=day;      REQ_LAUNCH_CPUS=4;  REQ_LAUNCH_MEM=16G;  REQ_LAUNCH_TIME=01:00:00; REQ_LAUNCH_PIN=

# T3 — the CPU chain: precompile + G0, THE SLEEPINESS ESTIMATES E1-E4 (spec 12, serial), their gate,
# prep, G2, prep gate, logit || draws, G4, logit gate + summary, archive. Measured on 2026-10-16 (job
# 29761158, turin): 56 min, MaxRSS 63.3 GB. Requested at about 1.5x the memory and 2x the wall;
# 16 cpus is what E1/E2's 4-way pool uses.
REQ_CHAIN_PART=day;       REQ_CHAIN_CPUS=16;  REQ_CHAIN_MEM=96G;   REQ_CHAIN_TIME=02:00:00;  REQ_CHAIN_PIN=cpugen:turin
# Threads given to the logit and to the draws: the deployed jobs had 8 cpus each and both read
# SLURM_CPUS_PER_TASK for --threads, so 8 keeps their thread count (and arithmetic) unchanged.
REQ_CHAIN_JULIA_THREADS=8
# Concurrent routines in the demand prep (sleep_run.sh's default; measured with it: 26 GB).
REQ_CHAIN_PREP_JOBS=4

# T2 — the GPU job: GPU sysimage build + load proof + CUDA gate, the one-process smoke over E1-E4,
# the draws gate, then the BLP hand-off (the ladders, the BBL hand-off, the blp archive).
# One routine at a time with the memory released between routines: ~175 GB peak -> 360G.
REQ_GPU_PART=gpu_h200;    REQ_GPU_GRES=h200:1; REQ_GPU_CPUS=8;    REQ_GPU_MEM=360G;  REQ_GPU_TIME=02:00:00
# Julia threads in the smoke (the four separate smoke processes had 6).
REQ_SMOKE_THREADS=6

# T4 — the CPU-image job, beside T3 (user, 10-14 23:1x): blp_sysimage_cpu.so built and load-proved
# on a turin node, for the BBL's CPU steps (bbl_job.sh loads it in every solve job). It also
# precompiles what the build needs (the launch only instantiates), so the wall allows for that.
REQ_CPUIMG_PART=day;      REQ_CPUIMG_CPUS=8;  REQ_CPUIMG_MEM=32G;  REQ_CPUIMG_TIME=01:00:00; REQ_CPUIMG_PIN=cpugen:turin

# The sleepiness BOOTSTRAPS (Pedro 10-15): separate jobs, submitted by T3 after the point-estimate
# gate, off the critical path (nothing waits on them). sleep_run.sh's production requests (no sacct
# record exists locally); cpugen:turin like the chain.
REQ_BOOT_PART=day;        REQ_BOOT_PIN=cpugen:turin
REQ_WCB_CPUS=8;           REQ_WCB_MEM=128G;   REQ_WCB_TIME=01:30:00     # E1/E2 percentile bands
REQ_AMEG_CPUS=4;          REQ_AMEG_MEM=16G;   REQ_AMEG_TIME=00:30:00    # E3/E4 AME off-path guard
REQ_AME_CPUS=64;          REQ_AME_MEM=256G;   REQ_AME_TIME=06:00:00     # E3/E4 two-stage AME bootstrap (64 workers)
# The FULL E2-E4 grids (Pedro 10-15), beside the chain like the bootstraps, under data/output/sleep_grid:
# one production estimator each (sleep_run.sh EST_*: 16c/128G/4h; E4's full grid was ~79 min serial).
REQ_GRID_CPUS=16;         REQ_GRID_MEM=128G;  REQ_GRID_TIME=04:00:00

# Small CPU jobs: hand-offs (next_blp, next_bbl, resume), the archives and the final check.
REQ_HANDOFF_PART=day;     REQ_HANDOFF_CPUS=2; REQ_HANDOFF_MEM=16G; REQ_HANDOFF_TIME=00:30:00; REQ_HANDOFF_PIN=
REQ_ZIP_PART=day;         REQ_ZIP_CPUS=2;     REQ_ZIP_MEM=8G;      REQ_ZIP_TIME=00:30:00;     REQ_ZIP_PIN=

# The RC ladders (blp_run.sh via cl_mem_for): unchanged until a MaxRSS exists (Q4).
REQ_RC_MEM=200G;          REQ_RC_MEM_BIG=600G

# The BBL forward-simulation shards (bbl_run.sh flags): unchanged, sized by bbl_sizing.sh.
REQ_BBL_PACK_H100=2;      REQ_BBL_MEM_H100=230G; REQ_BBL_SHARD_TIME=01:45:00
