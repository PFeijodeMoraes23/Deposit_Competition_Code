# BBL discount factor and forward-simulation horizon. This file is the single place both are set.
# Plain KEY=VALUE, so bash can `source` it and Python/Julia can parse it without dependencies.
#
# BBL_BETA    per-quarter discount factor: 1 / (1 + mean realized quarterly risk-free rate over
#             the 36 multi-start launch quarters 2016Q1-2024Q4). Annual equivalent BBL_BETA^4.
# BBL_HORIZON forward-simulation horizon in quarters: the shortest T whose discount weights
#             cover 99.5% of the infinite-horizon total, i.e. BBL_BETA^T <= 0.005.
BBL_BETA=0.979
BBL_HORIZON=250
#
# The derivation of BBL_BETA, recomputed 2026-09-24 from the built panel (nothing rebuilt);
# utils/bbl_discount.py reads these lines and the BBL tables quote them:
# BBL_RF_MEAN_Q  mean over BBL_RF_WINDOW of the realized quarterly risk-free rate, one value per
#                quarter; 1 / (1 + BBL_RF_MEAN_Q) = 0.978769, which rounds to BBL_BETA.
# BBL_RF_WINDOW  the multi-start launch quarters the mean is taken over (36 quarters).
# BBL_RF_SOURCE  file:column read. risk_free_qoq is daily Selic (SGS 11) compounded over each
#                quarter (panel_deposit_rates.py make_quarterly_macro); the demand parquet the BBL
#                forward simulation reads (demand_4_index_time_spec_12) carries the same column,
#                equal to the panel's in all 36 quarters.
BBL_RF_MEAN_Q=0.0216917188
BBL_RF_WINDOW=2016Q1-2024Q4
BBL_RF_SOURCE=market_panel.parquet:risk_free_qoq
